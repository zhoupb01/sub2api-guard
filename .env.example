# 必填。填入有 SELECT 权限的 PostgreSQL 连接串。
DATABASE_URL=
SUB2API_URL=http://sub2api:8080
# DRY_RUN=0 或测试单个账号时必填。
ADMIN_API_KEY=
# 测试专用的普通用户 API Key（sk-…），会绑定到测试分组。
PROBE_API_KEY=
# OpenAI 测试分组名，留空时使用「账号测试」。
PROBE_GROUP_NAME=账号测试
GROUP_ID=34
TICK_SECONDS=60
DRY_RUN=1
# 默认不推送。
BARK_URL=
STATE_FILE=/data/state.json
DECISION_LOG=/data/decisions.jsonl
MAX_CONCURRENCY=3
MAX_OVERRIDES={}
WINDOW_MIN=10
MIN_REQUESTS=20
ERROR_RATE=0.05
COOLDOWN_MIN=10
HEALTHY_MIN=30
HEALTHY_RATE=0.01
MIN_SCHEDULABLE=4
REOPEN_MIN=720
ERROR_PATTERNS=["overloaded","Concurrency limit exceeded for account"]
# 状态页共享密码。留空时不启动状态页。
WEB_PASSWORD=
