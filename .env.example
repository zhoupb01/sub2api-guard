# 必填。填入有 SELECT 权限的 PostgreSQL 连接串。
DATABASE_URL=
SUB2API_URL=http://sub2api:8080
# DRY_RUN=0 时必填。默认不需要。
ADMIN_API_KEY=
GROUP_ID=34
TICK_SECONDS=60
DRY_RUN=1
# 默认不推送。
BARK_URL=
STATE_FILE=/data/state.json
MAX_CONCURRENCY=3
MAX_OVERRIDES={}
WINDOW_MIN=10
MIN_REQUESTS=20
ERROR_RATE=0.05
COOLDOWN_MIN=10
HEALTHY_MIN=30
HEALTHY_RATE=0.01
MIN_SCHEDULABLE=4
ERROR_PATTERNS=["overloaded","Concurrency limit exceeded for account"]
